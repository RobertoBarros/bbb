{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rails",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(rails_requests_total[$__rate_interval]))",
          "legendFormat": "requisições/s",
          "refId": "A"
        }
      ],
      "title": "Requisições por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, controller, action) (rate(rails_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{controller}}#{{action}}",
          "refId": "A"
        }
      ],
      "title": "Latência p95 por endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (status_class) (label_replace(rate(rails_requests_total[$__rate_interval]), \"status_class\", \"${1}xx\", \"status\", \"([0-9])[0-9][0-9]\"))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "title": "Respostas por status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, controller, action) (rate(rails_request_duration_seconds_bucket[$__rate_interval])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Endpoints mais lentos (p95)",
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "Value"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "id": 6,
      "type": "row",
      "title": "Sidekiq",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (queue) (sidekiq_jobs_waiting_count)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs aguardando por fila",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 8,
      "targets": [
        {
          "expr": "max by (queue) (sidekiq_queue_latency)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Latência da fila",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (queue) (rate(sidekiq_jobs_success_total[$__rate_interval]))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs concluídos por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (queue) (rate(sidekiq_jobs_failed_total[$__rate_interval]))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs falhos por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue, worker) (rate(sidekiq_job_runtime_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{queue}} · {{worker}}",
          "refId": "A"
        }
      ],
      "title": "Tempo de execução p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum(sidekiq_jobs_retry_count)",
          "legendFormat": "aguardando nova tentativa",
          "refId": "A"
        },
        {
          "expr": "sum(sidekiq_jobs_dead_count)",
          "legendFormat": "mortos",
          "refId": "B"
        }
      ],
      "title": "Jobs em retry e mortos",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "prometheus",
    "rails",
    "sidekiq"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Rails e Sidekiq",
  "uid": "rails-sidekiq",
  "version": 1
}

