{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (queue) (sidekiq_jobs_waiting_count)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs aguardando por fila",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "max by (queue) (sidekiq_queue_latency)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Latência da fila",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (queue) (rate(sidekiq_jobs_success_total[$__rate_interval]))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs concluídos por segundo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (queue) (rate(sidekiq_jobs_failed_total[$__rate_interval]))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Jobs falhos por segundo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue, worker) (rate(sidekiq_job_runtime_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{queue}} · {{worker}}",
          "refId": "A"
        }
      ],
      "title": "Tempo de execução p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(sidekiq_jobs_retry_count)",
          "legendFormat": "aguardando nova tentativa",
          "refId": "A"
        },
        {
          "expr": "sum(sidekiq_jobs_dead_count)",
          "legendFormat": "mortos",
          "refId": "B"
        }
      ],
      "title": "Jobs em retry e mortos",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["sidekiq", "prometheus"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Sidekiq - Filas",
  "uid": "sidekiq-queues",
  "version": 1
}
