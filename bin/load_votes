#!/usr/bin/env ruby

require_relative "../config/environment"
require "cgi"
require "net/http"

$stdout.sync = true

rate = Integer(ENV.fetch("RATE", "1000"), 10)
duration = Integer(ENV.fetch("DURATION", "10"), 10)
concurrency = Integer(ENV.fetch("CONCURRENCY", "50"), 10)
base_url = ENV.fetch("BASE_URL", "http://localhost:3000")

abort "RATE deve ser maior que zero." unless rate.positive?
abort "DURATION deve ser maior que zero." unless duration.positive?
abort "CONCURRENCY deve ser maior que zero." unless concurrency.positive?

election = if ENV["ELECTION_ID"].present?
  Election.find(ENV.fetch("ELECTION_ID"))
else
  Election.find_by!(status: :open)
end

abort "A eleição precisa estar aberta." unless election.open?

candidacies = election.candidacies.includes(:candidate).order(:id).to_a
abort "A eleição não possui candidatos." if candidacies.empty?

weights = if candidacies.one?
  [ 100 ]
else
  leader_index = rand(candidacies.length)
  leader_weight = rand(70..90)
  remaining_indices = (0...candidacies.length).to_a - [ leader_index ]
  distribution = Array.new(candidacies.length, 0)
  distribution[leader_index] = leader_weight
  (100 - leader_weight).times { distribution[remaining_indices.sample] += 1 }
  distribution
end
weighted_candidacy_ids = candidacies.zip(weights).flat_map do |candidacy, weight|
  Array.new(weight, candidacy.id)
end
distribution = candidacies.zip(weights).map { |candidacy, weight| "#{candidacy.candidate.name}: #{weight}%" }.join(", ")

show_uri = URI.join(base_url, "/elections/#{election.id}")
show_response = Net::HTTP.get_response(show_uri)
abort "Não foi possível abrir a eleição: HTTP #{show_response.code}." unless show_response.is_a?(Net::HTTPSuccess)

csrf_token = show_response.body[/<meta name="csrf-token" content="([^"]+)"/, 1]
abort "Token CSRF não encontrado na página da eleição." unless csrf_token
csrf_token = CGI.unescapeHTML(csrf_token)

cookie = show_response.get_fields("set-cookie")&.map { |value| value.split(";", 2).first }&.join("; ")
vote_uri = URI.join(base_url, "/elections/#{election.id}/votes")
requests = Queue.new
results = Queue.new
total = rate * duration
interrupted = false

Signal.trap("INT") { interrupted = true }

workers = concurrency.times.map do
  Thread.new do
    http = Net::HTTP.new(vote_uri.host, vote_uri.port)
    http.use_ssl = vote_uri.scheme == "https"
    http.open_timeout = 5
    http.read_timeout = 5
    http.write_timeout = 5

    while (candidacy_id = requests.pop)
      break if interrupted

      begin
        http.start unless http.started?
        request = Net::HTTP::Post.new(vote_uri)
        request["Cookie"] = cookie if cookie
        request.set_form_data(
          "authenticity_token" => csrf_token,
          "vote[candidacy_id]" => candidacy_id
        )

        response = http.request(request)
        results << response.code.to_i
      rescue StandardError => error
        results << error
      end
    end
  ensure
    http&.finish if http&.started?
  end
end

started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
scheduled = 0

duration.times do |second|
  break if interrupted

  rate.times do
    break if interrupted

    requests << weighted_candidacy_ids.sample
    scheduled += 1
  end

  sleep_until = started_at + second + 1
  sleep_time = sleep_until - Process.clock_gettime(Process::CLOCK_MONOTONIC)
  sleep(sleep_time) if sleep_time.positive? && !interrupted

  puts "Segundo #{second + 1}: #{results.size}/#{scheduled} concluídas, #{requests.size} aguardando"
end

requests.clear
concurrency.times { requests << nil }
workers.each(&:join)

elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
responses = []
responses << results.pop until results.empty?
successes = responses.count { |response| response == 302 || response == 303 }
failures = responses.length - successes
discarded = scheduled - responses.length
actual_rate = successes / (interrupted ? elapsed : duration)

puts "Eleição: #{election.title} (#{election.id})"
puts "Distribuição: #{distribution}"
puts "Requisições programadas: #{scheduled}"
puts "Respostas de sucesso: #{successes}"
puts "Falhas: #{failures}"
puts "Descartadas ao encerrar: #{discarded}"
puts "Tempo total: #{elapsed.round(2)}s"
puts "Taxa alcançada: #{actual_rate.round(2)} votos/s"

if failures.positive?
  sample = responses.find { |response| response != 302 && response != 303 }
  warn "Primeira falha: #{sample.is_a?(Exception) ? "#{sample.class}: #{sample.message}" : "HTTP #{sample}"}"
end

exit 130 if interrupted

abort "Ocorreram falhas nas requisições." if failures.positive?
abort "A taxa mínima de #{rate} votos/s não foi alcançada." if successes < total || elapsed > duration + 0.1
